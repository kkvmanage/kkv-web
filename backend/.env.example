# ==============================================================================
# KKV Gold Finance & Rental Management - Backend Environment Template
# ==============================================================================

# Server
PORT=8080
NODE_ENV=development

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb://127.0.0.1:27017/kkv_gold_finance

# Authentication & Security (JWT)
JWT_SECRET=your_super_strong_jwt_secret_key_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m

# Initial Master Admin Seeding (Used during database bootstrap/seeding)
ADMIN_NAME=KKV Master Admin
ADMIN_EMAIL=admin@kkvgoldfinance.com
ADMIN_PASSWORD=SetAStrongPasswordHere123!

# Local Data Storage
LOCAL_STORAGE_PATH=./data
